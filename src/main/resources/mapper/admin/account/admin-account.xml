<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shapinel.addonmanager.admin.account.AdminAccountMapper">

    <select id="selectAccounts"
            resultType="com.shapinel.addonmanager.admin.account.domain.dto.AdminAccountDtos$AccountListDto">
        SELECT id
             , login_id   AS loginId
             , name
             , role
             , status
             , created_at AS createdAt
        FROM account
        WHERE deleted_at IS NULL
        <if test="status != null">
          AND status = #{status}
        </if>
        ORDER BY id DESC
    </select>
</mapper>
